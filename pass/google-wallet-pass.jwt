{
  "iss": "YOUR_GOOGLE_ISSUER_ID",
  "aud": "google",
  "typ": "savetowallet",
  "payload": {
    "genericObjects": [
      {
        "id": "amber-wellness-badge-123",
        "classId": "amber-wellness-class",
        "logo": {
          "sourceUri": {
            "uri": "https://amberl-tech.github.io/digital-wallet/pass/icon.png"
          }
        },
        "cardTitle": {
          "defaultValue": {
            "language": "en-US",
            "value": "Amber Wellness Badge"
          }
        },
        "subheader": {
          "defaultValue": {
            "language": "en-US",
            "value": "Wellness Streak"
          }
        },
        "header": {
          "defaultValue": {
            "language": "en-US",
            "value": "7 days in a row"
          }
        },
        "barcode": {
          "type": "QR_CODE",
          "value": "cred-123456"
        },
        "hexBackgroundColor": "#4B0082"
      }
    ]
  }
}
